<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>UNO.CHESS</title>

<style>
body {
  margin: 0;
  padding: 20px 10px;
  background: #111827;
  color: white;
  font-family: Arial, sans-serif;
  text-align: center;
}

h1 { color: #facc15; }

#board {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  width: min(92vw, 480px);
  margin: 20px auto;
  border: 4px solid #facc15;
}

.square {
  aspect-ratio: 1;
  display: grid;
  place-items: center;
  font-size: clamp(23px, 8vw, 48px);
  cursor: pointer;
  user-select: none;
}

.light { background: #eee; color: #111; }
.dark { background: #64748b; color: #111; }

.square.selected {
  background: #facc15 !important;
}

.possible {
  box-shadow: inset 0 0 0 5px #22c55e;
}

button {
  background: #facc15;
  border: 0;
  border-radius: 10px;
  padding: 12px 20px;
  font-weight: bold;
  font-size: 16px;
  cursor: pointer;
}

#status { color: #93c5fd; }

#uno-cards {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10px;
  max-width: 500px;
  margin: 20px auto;
}

.uno-card {
  width: 68px;
  height: 100px;
  padding: 0;
  border: 3px solid white;
  border-radius: 14px;
  color: white;
  font-size: 24px;
  font-weight: bold;
}

.uno-card.selected {
  outline: 4px solid white;
  transform: translateY(-8px);
}

.cards {
  font-size: 35px;
  margin: 20px;
}
</style>
</head>

<body>

<h1>UNO.CHESS</h1>
<h2>Cartes UNO CHESS</h2>
<div id="uno-cards"></div>

<p>Échecs + UNO : un seul jeu !</p>

<p id="status">Tour des blancs</p>
<div id="board"></div>

<button onclick="findGame()">JOUER EN LIGNE</button>
<button onclick="resetGame()">Nouvelle partie</button>

<div class="cards">🟥 🟦 🟩 🟨</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.10.3/chess.min.js"></script>
<script src="https://cdn.socket.io/4.8.1/socket.io.min.js"></script>
<script>
const game = new Chess();
const socket = io("https://uno-chess-server.onrender.com");
socket.on("game-action", (data) => {
  if (data.move) {
    game.move({
      from: data.move.from,
      to: data.move.to,
      promotion: data.move.promotion || "q"
    });

    selected = null;
    possible = [];
    drawBoard();
  }
});
let room = null;
let myColor = null;
socket.on("connect", () => {
  status.textContent = "Connecté au serveur !";
});

socket.on("waiting", () => {
  status.textContent = "En attente d'un adversaire...";
});

socket.on("game-found", (data) => {
  room = data.room;
  myColor = data.color;
  status.textContent = "Adversaire trouvé ! Tu joues les " + myColor;
});

function findGame() {
  socket.emit("find-game");
}
const board = document.getElementById("board");
const status = document.getElementById("status");

const symbols = {
  wk:"♔", wq:"♕", wr:"♖", wb:"♗", wn:"♘", wp:"♙",
  bk:"♚", bq:"♛", br:"♜", bb:"♝", bn:"♞", bp:"♟"
};

let selected = null;
let possible = [];

function drawBoard() {
  board.innerHTML = "";
  const position = game.board();

  position.forEach((row, r) => {
    row.forEach((piece, c) => {
      const square = document.createElement("div");
      const file = "abcdefgh"[c];
      const rank = 8 - r;
      const name = file + rank;

      square.className = "square " +
        ((r + c) % 2 === 0 ? "light" : "dark");

      if (selected === name) square.classList.add("selected");
      if (possible.includes(name)) square.classList.add("possible");

      if (piece) {
        square.textContent = symbols[piece.color + piece.type];
      }

      square.onclick = () => playSquare(name);
      board.appendChild(square);
    });
  });

  if (game.in_checkmate()) {
    status.textContent = "Échec et mat ! Partie terminée.";
  } else if (game.in_draw()) {
    status.textContent = "Match nul !";
  } else {
    status.textContent =
      "Tour des " + (game.turn() === "w" ? "blancs" : "noirs");
    if (game.in_check()) status.textContent += " — Échec !";
  }
}

function playSquare(name) {
  if (selected && possible.includes(name)) {
    const move = game.move({
      from: selected,
      to: name,
      promotion: "q"
    });

   if (move) {
  selected = null;
  possible = [];

  if (room) {
    socket.emit("game-action", {
      room: room,
      move: move
    });
  }

  drawBoard();
  return;
}
  }

  const moves = game.moves({
    square: name,
    verbose: true
  });

  if (moves.length) {
    selected = name;
    possible = moves.map(move => move.to);
  } else {
    selected = null;
    possible = [];
  }

  drawBoard();
}

function resetGame() {
  game.reset();
  selected = null;
  possible = [];
  drawBoard();
}

drawBoard();
</script>

<script>
const container = document.getElementById("uno-cards");

const colors = {
  red: "#ef4444",
  yellow: "#eab308",
  green: "#16a34a",
  blue: "#2563eb"
};

Object.entries(colors).forEach(([color, hex]) => {
  for (let n = 0; n <= 9; n++) {
    addCard(n, hex);
  }

  ["+2", "↔", "PASSE"].forEach(value => {
    addCard(value, hex);
  });
});

function addCard(value, color) {
  const card = document.createElement("button");
  card.className = "uno-card";
  card.style.backgroundColor = color;
  card.textContent = value;
  card.onclick = () => card.classList.toggle("selected");
  container.appendChild(card);
}
</script>

</body>
</html>
